# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
build/
dist/

# Generated data. Reproducible from configs/*.yaml and the fixed seed, and a
# synthetic survey corpus is not worth carrying in the repo.
data/

# Raw per-run output is regenerated by `make ablate` and is large. The
# aggregated summaries (baseline.json, ablation.json, adversarial.json) are
# NOT ignored: every number the README quotes is traceable to one of them
# without re-running anything.
results/raw/
results/*.log

# reports/evaluation.html is NOT ignored: it is committed with real results so
# a visitor sees the findings without running anything.

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
